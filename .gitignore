# Local settings with secrets: NEVER committed (use .env.example as the template)
.env
.env.*
!.env.example

# Generated data
data/
bench/results/
app/bench/results/

# Documents to index: user content, never versioned (samples live in examples/documents)
documents/*
!documents/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Code knowledge graph (graphify): regenerated by `graphify update .` and the git hooks
graphify-out/

# Backups of the HA deployment (scripts/backup-ha.sh)
backups/

# Kubernetes local secrets (generated by deploy/k8s/scripts/secrets.sh)
deploy/k8s/.local-secrets.env
# Rendered by deploy/k8s/scripts/deploy.sh on every deploy
deploy/k8s/.generated/
