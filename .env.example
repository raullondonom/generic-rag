# =====================================================================
#  RAG genérico - configuración
#  Copia este archivo a ".env" y ajusta los valores:  cp .env.example .env
#  El archivo .env está en .gitignore: nunca se sube al repositorio.
# =====================================================================

# ---------- GPU NVIDIA (opcional) ----------
# Sin estas líneas, Ollama funciona en CPU (más lento). Con GPU NVIDIA, descoméntalas:
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml

# ---------- Proveedor de IA por defecto ----------
# ollama    -> modelo local (GPU) en el contenedor de Ollama
# anthropic -> Claude vía API (requiere ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama

# ---------- Ollama (local) ----------
OLLAMA_CHAT_MODEL=qwen3:8b
# Modo "thinking" de qwen3: más lento pero razona más. false = respuestas directas
OLLAMA_THINK=false
# Ventana de contexto del modelo local (tokens). Más contexto = más VRAM.
# Con 8 GB de VRAM (qwen3:8b + bge-m3) 12288 es el máximo estable.
OLLAMA_NUM_CTX=12288
# Cuantización de la caché KV (f16 | q8_0 | q4_0): q8_0 usa la mitad de VRAM que f16
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
# Capas del modelo de chat que se cargan en la GPU (-1 = automático). Si aparece
# "cudaMalloc failed: out of memory", bájalo: el resto de capas se ejecuta en CPU.
# qwen3:8b tiene 37 capas; con 8 GB de VRAM compartidos con bge-m3, 30 funciona bien.
OLLAMA_NUM_GPU=30
# Modelo de embeddings (siempre local). Si lo cambias, borra la colección y reindexa
EMBED_MODEL=bge-m3

# ---------- Anthropic Claude (remoto) ----------
# Secreto: por defecto docker compose lo toma de la variable de entorno de Windows
# GENRIC_RAG_ANTHROPIC_API_KEY. Puedes descomentarlo aquí para sobrescribirlo.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
# Reintento automático en otro modelo si Claude rechaza la petición (server-side fallback)
ANTHROPIC_FALLBACKS=true

# ---------- Recuperación (RAG) ----------
COLLECTION_NAME=documentos
# Número de fragmentos enviados como contexto
TOP_K=8
# Similitud mínima (0-1). Si ningún fragmento la supera, no se llama a la IA
# y se le pide más información al usuario.
MIN_SCORE=0.45
# Descarta fragmentos cuya similitud esté más de este margen por debajo del mejor resultado
SCORE_MARGIN=0.12
# Tamaño y solape de los fragmentos (caracteres)
CHUNK_SIZE=3000
CHUNK_OVERLAP=400
# Turnos de conversación previos que se envían a la IA
HISTORY_TURNS=6

# ---------- Carpeta de documentos ----------
# Ruta en el host que se monta (solo lectura) dentro del contenedor
DOCS_HOST_PATH=./documentos
# Cada cuántos segundos se revisa la carpeta buscando cambios
FOLDER_SCAN_INTERVAL=60
# Tamaño máximo de archivo a procesar (MB)
MAX_FILE_MB=100
# OCR (Tesseract) para PDFs escaneados e imágenes: más lento
OCR_ENABLED=false
OCR_LANGS=spa+eng

# ---------- Confluence Cloud ----------
CONFLUENCE_ENABLED=false
CONFLUENCE_URL=https://tu-empresa.atlassian.net/wiki
# Credenciales: por defecto se toman de las variables de Windows JIRA_EMAIL / JIRA_TOKEN.
# Descomenta para sobrescribirlas.
# CONFLUENCE_EMAIL=usuario@empresa.com
# CONFLUENCE_TOKEN=token-de-atlassian
# Claves de los espacios a indexar (separadas por coma). Se ven en la URL: /wiki/spaces/<CLAVE>/...
CONFLUENCE_SPACES=ESPACIO1,ESPACIO2
# Descargar e indexar adjuntos (PDF, Word, Excel...) de las páginas
CONFLUENCE_INCLUDE_ATTACHMENTS=true
CONFLUENCE_MAX_ATTACHMENT_MB=50
# Cada cuántos minutos se sincroniza Confluence (0 = solo manual / al arrancar)
CONFLUENCE_SYNC_MINUTES=60

# ---------- ngrok (túnel público para pruebas, opcional) ----------
# Arranque: docker compose --profile ngrok up -d   ·   URL pública: http://localhost:4040
# El authtoken se toma de la variable de entorno de Windows NGROK_AUTHTOKEN (o descoméntalo aquí).
# NGROK_AUTHTOKEN=
# Usuario y contraseña que pedirá el navegador (contraseña de 8 a 128 caracteres)
NGROK_BASIC_AUTH=usuario:cambia-esta-contraseña
# Dominio fijo opcional (el plan gratuito incluye uno: dashboard.ngrok.com -> Domains)
NGROK_DOMAIN=

# ---------- Aplicación ----------
# Puerto en localhost para la interfaz web y la API
APP_PORT=8000
LOG_LEVEL=INFO
