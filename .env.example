# =====================================================================
#  Generic RAG - settings
#  Copy this file to ".env" and adjust the values:  cp .env.example .env
#  .env is in .gitignore: it is never committed.
# =====================================================================

# ---------- Optional services and GPU ----------
# "ollama" starts the local model used to answer without Claude. It only starts when there is NO Claude
# API key; to run both, use COMPOSE_PROFILES=ollama,ollama-with-claude and OLLAMA_WITH_CLAUDE=true.
COMPOSE_PROFILES=ollama
# Without these lines everything runs on the CPU (slower). With an NVIDIA GPU, uncomment them:
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml
# Or let ./scripts/compose.sh detect the GPU (NVIDIA, AMD/ROCm or CPU) and use it instead of "docker compose".
# AMD (ROCm, Linux only): Ollama on GPU, embeddings stay on CPU. Manual alternative:
# COMPOSE_FILE=docker-compose.yml,docker-compose.amd.yml
# RENDER_GID=993                # host group id of "render": getent group render
# HIP_VISIBLE_DEVICES=0         # only with several GPUs: index of the discrete one
# HSA_OVERRIDE_GFX_VERSION=     # only if ollama logs say the GPU is not supported

# ---------- Several instances on one machine ----------
# Each instance (e.g. one per document collection) needs its own project name and free ports.
# COMPOSE_PROJECT_NAME=my-collection-rag
# QDRANT_PORT=6333
# OLLAMA_PORT=11434
# NGROK_PANEL_PORT=4040

# ---------- Administration ----------
# Token of the administration panel (/admin) and its API (index, reindex, source review, spend,
# provider). Empty = the panel only answers from this machine, never through ngrok.
# By default it is read from the GENRIC_RAG_ADMIN_TOKEN environment variable.
# ADMIN_TOKEN=

# ---------- Language ----------
# Language of the UI, the canned answers and the prompts: en | es
LANGUAGE=en

# ---------- Default AI provider ----------
# auto      -> Claude if ANTHROPIC_API_KEY is set; otherwise Ollama
# anthropic -> always Claude      ·   ollama -> always the local model
# Any available provider can be picked in the UI.
LLM_PROVIDER=auto

# ---------- Anthropic Claude (remote) ----------
# Secret: by default docker compose reads it from the GENRIC_RAG_ANTHROPIC_API_KEY environment
# variable. You can uncomment it here to override it.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# Cheap model used to rewrite follow-up questions
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
# Automatic retry on another model if Claude declines the request (server-side fallback)
ANTHROPIC_FALLBACKS=true
# Monthly spending cap in USD. The worst case is estimated before each call; if it does not fit,
# the call is not made.
MONTHLY_BUDGET_USD=10
# Time zone of the budget's month cut-off and of the daily syncs
TZ=UTC
# true = simulated Claude: the whole flow works without calling the API or spending
DRY_RUN=false

# ---------- Ollama (local) ----------
# Empty = Ollama disabled
OLLAMA_URL=http://ollama:11434
# Also offer Ollama when Claude is available (needs the ollama-with-claude profile above)
OLLAMA_WITH_CLAUDE=false
# Model picked with the benchmark (app/bench/llm_benchmark.py) for 8 GB of VRAM
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
# "Thinking" mode: slower but reasons more. false = direct answers
OLLAMA_THINK=false
# Context window of the local model (tokens). More context = more VRAM.
OLLAMA_NUM_CTX=12288
# KV cache quantization (f16 | q8_0 | q4_0): q8_0 uses half the VRAM of f16
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
# Model layers on the GPU (-1 = automatic). If "cudaMalloc failed: out of memory" shows up, lower it:
# the remaining layers run on the CPU.
OLLAMA_NUM_GPU=-1

# ---------- Embeddings (always local) ----------
# Hugging Face model served by text-embeddings-inference. Every model has its own Qdrant
# collection: if you change it, everything is reindexed at startup and the old collection is deleted.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# TEI image with GPU for your architecture (https://github.com/huggingface/text-embeddings-inference):
#   RTX 40xx / L4 / L40 -> 89-1.9   ·   RTX 30xx / A10 -> 86-1.9   ·   A100 -> 1.9
#   RTX 20xx / T4 -> turing-1.9      ·   H100 -> hopper-1.9
# TEI_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.9
# Only for private or gated models on Hugging Face
# HF_TOKEN=

# ---------- Redaction ----------
# Removes keys, tokens, passwords and connection strings before indexing and before sending to Claude
REDACT_SECRETS=true
# Also emails, card numbers and ID or account numbers (may hide useful contact details)
REDACT_PERSONAL_DATA=false

# ---------- Database ----------
# Postgres password (only reachable inside the Docker network). Letters and digits only.
# By default it is read from the GENRIC_RAG_POSTGRES_PASSWORD environment variable.
# POSTGRES_PASSWORD=
# Days an inactive conversation is kept (0 = forever)
CONVERSATION_RETENTION_DAYS=180

# ---------- Retrieval (RAG) ----------
COLLECTION_PREFIX=documents
# Number of chunks sent as context
TOP_K=10
# Before searching, a fast model fixes the spelling, rewrites the question self-contained and splits
# it into one search per topic; the answering model sees that interpretation and checks it.
# false = search with the question as typed (no extra call).
QUERY_PREPARATION=true
# Searches per question besides the question itself (results fused by reciprocal rank fusion)
SEARCH_QUERIES_MAX=3
# Reranking: the hybrid search gathers RERANK_CANDIDATES chunks and the fast model (ANTHROPIC_FAST_MODEL or
# the local model) scores how much each one helps to answer; only the useful ones, up to TOP_K, reach the
# answering model. Fewer and better chunks: shorter, more precise answers. With Claude, about USD 0.002
# per question with Haiku.
RERANK=false
RERANK_CANDIDATES=30
# Hybrid search, lexical half: a BM25 sparse vector per chunk next to its embedding (words folded and
# stemmed in LANGUAGE, codes such as "C.11" kept whole; Qdrant applies the IDF). It finds exact terms
# the embeddings miss. Changing it creates a new collection: everything is indexed again.
SPARSE_SEARCH=true
# Hybrid search: the preparation also returns keywords (the question's distinctive terms and the
# synonyms or official terms the documents may use); each one runs a semantic search restricted to the
# chunks that contain it (full-text index of Qdrant in LANGUAGE: no accents, stemmed, no stopwords)
KEYWORD_SEARCH=true
SEARCH_KEYWORDS_MAX=3
# A keyword found in more than this share of the chunks is too generic to filter and is skipped.
# The remaining ones (rarest first) get up to half of TOP_K, one chunk per document.
KEYWORD_MAX_SHARE=0.02
# At most this many chunks of the same document in the context (room for other documents)
MAX_CHUNKS_PER_DOC=2
# Minimum similarity (0-1). If no chunk reaches it, the AI is not called and the user is asked
# for more information.
MIN_SCORE=0.45
# Drops chunks whose similarity is more than this margin below the best hit
SCORE_MARGIN=0.12
# Registry statuses (see the control folder) left out of the search, lowercase, comma separated
EXCLUDE_STATUSES=repealed,derogada,derogado
# Chunk size and overlap (characters)
CHUNK_SIZE=3000
# Contextual retrieval: while indexing, a fast Claude model writes a short search note per chunk (what
# it establishes, in the terms people search for, guided by the collection's search notes). The note is
# embedded and full-text indexed with the chunk; the answering model still reads the original text.
# Needs ANTHROPIC_API_KEY, counts against MONTHLY_BUDGET_USD (roughly USD 0.15-0.25 per 1,000 chunks
# with Haiku) and is cached in Postgres, so only new or changed chunks cost anything. Turning it on or
# off, or editing the search notes, indexes every document again.
CONTEXTUAL_INDEXING=false
# CONTEXT_MODEL=            # empty = ANTHROPIC_FAST_MODEL
# CONTEXT_WORKERS=8         # parallel calls while indexing
CHUNK_OVERLAP=400
# Previous conversation turns sent to the AI. 0 = every question is an independent query
HISTORY_TURNS=0

# ---------- Documents folder ----------
# Host path mounted (read only) inside the container
DOCS_HOST_PATH=./documents
# How often (seconds) the folder is checked for changes. 0 = automatic updates off (manual only)
FOLDER_SCAN_INTERVAL=60
# Maximum file size to process (MB). Raise it for big manuals or scanned books
MAX_FILE_MB=100
# OCR (Tesseract) for scanned PDFs and images: slower
OCR_ENABLED=false
OCR_LANGS=eng+spa
# Files and folders whose name starts with one of these are never indexed. "_" is reserved for
# metadata: the control folder, archived versions (_archive), history (_historico)...
IGNORE_PREFIXES=.,_,~$
# OCR text of a scanned PDF (<name>.ocr.txt beside <name>.pdf) is indexed instead of the PDF; empty = off
OCR_SIDECAR_SUFFIX=.ocr.txt

# ---------- Source control folder (optional) ----------
# Folder inside the documents folder with the registries of where each document came from
# (control_config.json + sources_*.csv, see the README). When present, documents get their title,
# jurisdiction, status and official URL from it, and the sources are reviewed every day.
CONTROL_DIR=_control
# Daily review time, HH:MM (24 h) in TZ. Empty = only from the side panel. It only reports:
# nothing is downloaded or reindexed, and no AI is used.
CONTROL_CHECK_TIME=16:00
# Also fingerprint the remote URLs to detect changed sources (uses ETag / Last-Modified when possible)
CONTROL_CHECK_ONLINE=true
CONTROL_CHECK_WORKERS=6

# ---------- Confluence Cloud (optional) ----------
CONFLUENCE_ENABLED=false
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
# Credentials: by default read from the JIRA_EMAIL / JIRA_TOKEN environment variables.
# Uncomment to override them.
# CONFLUENCE_EMAIL=user@company.com
# CONFLUENCE_TOKEN=atlassian-api-token
# Keys of the spaces to index (comma separated). They show in the URL: /wiki/spaces/<KEY>/...
CONFLUENCE_SPACES=SPACE1,SPACE2
# Download and index page attachments (PDF, Word, Excel...)
CONFLUENCE_INCLUDE_ATTACHMENTS=true
CONFLUENCE_MAX_ATTACHMENT_MB=50
# Daily sync time, HH:MM (24 h) in TZ. Empty = only manually (and once on the first start)
CONFLUENCE_SYNC_TIME=16:00

# ---------- ngrok (public tunnel for testing, optional) ----------
# Start: docker compose --profile ngrok up -d   ·   Public URL: http://localhost:4040
# The authtoken is read from the NGROK_AUTHTOKEN environment variable (or uncomment it here).
# NGROK_AUTHTOKEN=
# User and password the browser will ask for (password of 8 to 128 characters)
NGROK_BASIC_AUTH=user:change-this-password
# Optional fixed domain (the free plan includes one: dashboard.ngrok.com -> Domains)
NGROK_DOMAIN=

# ---------- Application ----------
# Port on localhost for the web UI and the API
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- High availability (docker-compose.ha.yml, see "High availability" in the README) ----------
# HA_PORT=8080
# HA_RATE_ASK=2r/s            # questions per second per IP
# HA_BURST_ASK=10
# HA_CONN_PER_IP=100
# WORKER_REPLICAS=2
# WORKER_CONCURRENCY=16
# QUEUE_MAX_PENDING=500       # more waiting questions are answered with 429
# EMBEDDINGS_MEMORY=5g
# QDRANT_MEMORY=1g
