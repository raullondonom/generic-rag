# Kubernetes variant of deploy/nginx/edge.conf.template: the upstreams are Services.
# The nginx image renders this file with envsubst into /etc/nginx/conf.d/default.conf.

limit_req_zone  $binary_remote_addr zone=ask:10m    rate=${RATE_ASK};
limit_req_zone  $binary_remote_addr zone=api:10m    rate=${RATE_API};
limit_req_zone  $binary_remote_addr zone=static:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=conns:10m;

limit_req_status  429;
limit_conn_status 429;

upstream rag_api {
    zone rag_api 64k;
    least_conn;
    server api:8000 max_fails=2 fail_timeout=10s;
    keepalive 64;
}

upstream rag_scheduler {
    zone rag_scheduler 64k;
    least_conn;
    server scheduler:8000 max_fails=2 fail_timeout=10s;
    keepalive 4;
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    charset utf-8;

    # Probe for the pod itself (does not depend on the application).
    location = /nginx-health {
        access_log off;
        return 200 "ok";
    }

    client_max_body_size 64k;
    client_body_timeout  15s;
    client_header_timeout 15s;
    send_timeout 30s;
    limit_conn conns ${CONN_PER_IP};

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 3s;

    # Questions: queued (202) or streamed; never buffered.
    location ~ ^/api/chat(/jobs)?$ {
        limit_req zone=ask burst=${BURST_ASK} nodelay;
        proxy_pass http://rag_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # Answer by job id (status, resumable SSE, cancel).
    location ~ ^/api/chat/jobs/ {
        limit_req zone=api burst=${BURST_API} nodelay;
        proxy_pass http://rag_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Indexing and administration live in the scheduler instance.
    location ~ ^/(admin|api/admin|api/control|api/documents|api/reindex|api/feedback/summary) {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://rag_scheduler;
        proxy_read_timeout 120s;
    }

    location /api/ {
        limit_req zone=api burst=${BURST_API} nodelay;
        proxy_pass http://rag_api;
        proxy_read_timeout 60s;
    }

    location /health {
        access_log off;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://rag_api;
    }

    location / {
        limit_req zone=static burst=100 nodelay;
        proxy_pass http://rag_api;
        proxy_cache off;
        proxy_read_timeout 30s;
    }

    error_page 429 = @busy;
    error_page 502 503 504 = @down;
    location @busy {
        internal;
        default_type application/json;
        add_header Retry-After 10 always;
        return 429 '{"detail":"${MSG_BUSY}"}';
    }
    location @down {
        internal;
        default_type application/json;
        add_header Retry-After 15 always;
        return 503 '{"detail":"${MSG_DOWN}"}';
    }
}
